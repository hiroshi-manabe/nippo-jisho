        {"id": "c1m-l009", "runs": [{"typeface": "roman", "text": "Zzufat. i, Camigue."}, {"typeface": "italic", "text": " Cabellos da cabeça."}]},
        {"id": "c1m-l010", "runs": [{"typeface": "roman", "text": "Zzufǔ."}, {"typeface": "italic", "text": " Certa doença da cabeça cauſada de frio."}]},
        {"id": "c1m-l011", "indent": 1, "runs": [{"typeface": "italic", "text": "¶"}, {"typeface": "roman", "text": " Zzufǔga vocotta."}, {"typeface": "italic", "text": " Veome eſta doença."}]},
