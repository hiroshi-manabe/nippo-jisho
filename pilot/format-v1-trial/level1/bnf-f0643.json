        {"id": "c1m-l001", "runs": [{"typeface": "roman", "text": "Zzudat. l, yodare caqe."}, {"typeface": "italic", "text": " Babeira que poem"}]},
        {"id": "c1m-l002", "indent": 1, "runs": [{"typeface": "italic", "text": "aos mininos dependurada do peſcoço, ou de"}]},
        {"id": "c1m-l003", "indent": 1, "runs": [{"typeface": "italic", "text": "que uſão as molheres como corpinho, & tam-"}]},
        {"id": "c1m-l004", "indent": 1, "runs": [{"typeface": "italic", "text": "bem os Bonzos Ienxùs pera quando fazem offi-"}]},
        {"id": "c1m-l005", "indent": 1, "runs": [{"typeface": "italic", "text": "cios baixos."}]},
        {"id": "c1m-l006", "runs": [{"typeface": "roman", "text": "Zzudazzudani."}, {"typeface": "italic", "text": " Adu. Em pedaçinhos. Vt,"}]},
        {"id": "c1m-l007", "indent": 1, "runs": [{"typeface": "roman", "text": "Zzudazzudani qiru."}, {"typeface": "italic", "text": " Cortar em pedaçinhos:"}]},
