          ]
        },
        {
          "id": "c1-l043",
          "indent": 1,
          "runs": [
            {
              "typeface": "roman",
              "text": "tçugu."
            },
            {
              "typeface": "italic",
              "text": " Dar com a taboinha neſta feſta."
            }
          ]
        },
        {
          "id": "c1-l044",
          "runs": [
            {
              "typeface": "roman",
              "text": "Fagocumi, u, da."
            },
            {
              "typeface": "italic",
              "text": " Soſſentar. ¶"
