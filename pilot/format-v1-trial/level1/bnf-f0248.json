      "lines": [
        {"id": "c1d-l001", "runs": [{"typeface": "roman", "text": "Goxu. Von ſaqe."}, {"typeface": "italic", "text": " Vinho falando com reſpeito."}]},
        {"id": "c1d-l002", "runs": [{"typeface": "roman", "text": "Goxxǒ. i, Acugôno ſauari."}, {"typeface": "italic", "text": " Embaraços,"}]},
        {"id": "c1d-l003", "indent": 1, "runs": [{"typeface": "italic", "text": "ou impedimentos que nacem do peccado."}]},
        {"id": "c1d-l004", "runs": [{"typeface": "roman", "text": "Goya. Yafan."}, {"typeface": "italic", "text": " Mea noite."}]},
        {"id": "c1d-l005", "runs": [{"typeface": "roman", "text": "Goyei. Micague."}, {"typeface": "italic", "text": " Imagem pintada, falando"}]},
        {"id": "c1d-l006", "indent": 1, "runs": [{"typeface": "italic", "text": "com reuerencia. No Cami ſe diz,"}, {"typeface": "roman", "text": " Miyei."}]},
        {"id": "c1d-l007", "runs": [{"typeface": "roman", "text": "Gǒyei. Tçuyoi yen."}, {"typeface": "italic", "text": " Grande, & poderoſa"}]},
        {"id": "c1d-l008", "indent": 1, "runs": [{"typeface": "italic", "text": "amizade. Vt,"}, {"typeface": "roman", "text": " Gǒyeiuo motte tanomu."}]},
        {"id": "c1d-l009", "indent": 1, "runs": [{"typeface": "italic", "text": "Rogar algum amigo mais forte, & poderoſo"}]},
        {"id": "c1d-l010", "indent": 1, "runs": [{"typeface": "italic", "text": "pera que com ſeu fauor vença algũa demanda,"}]},
        {"id": "c1d-l011", "indent": 1, "runs": [{"typeface": "italic", "text": "ou poſſa contra o competidor, &c."}]},
        {"id": "c1d-l012", "runs": [{"typeface": "roman", "text": "Goyô."}, {"typeface": "italic", "text": " Neceſſidade, ou negocio de peſſoa"}]},
        {"id": "c1d-l013", "indent": 1, "runs": [{"typeface": "italic", "text": "honrada."}]},
        {"id": "c1d-l014", "runs": [{"typeface": "roman", "text": "Goyô. Itçutçuno fa."}, {"typeface": "italic", "text": " Folha que tem em ſi cin-"}]},
        {"id": "c1d-l015", "indent": 1, "runs": [{"typeface": "italic", "text": "co. Vt,"}, {"typeface": "roman", "text": " Goyôno matçu."}, {"typeface": "italic", "text": " Pinheiro que"}]},
        {"id": "c1d-l016", "indent": 1, "runs": [{"typeface": "italic", "text": "tem as folhas de cinco pernas cada hũa."}]}
      ]
    },
    {
