        {"id": "c2g-l001", "runs": [{"typeface": "roman", "text": "Guchimuchi."}, {"typeface": "italic", "text": " Ignorancia, ou pouco ſaber."}]},
        {"id": "c2g-l002", "runs": [{"typeface": "roman", "text": "Guchiua."}, {"typeface": "italic", "text": " Ignorante, ſem ſaber."}]},
        {"id": "c2g-l003", "runs": [{"typeface": "roman", "text": "Guchini."}, {"typeface": "italic", "text": " Adu."}]},
        {"id": "c2g-l004", "runs": [{"typeface": "roman", "text": "Gǔcan. Faluno ne."}, {"typeface": "italic", "text": " Raiz do golfão."}]},
        {"id": "c2g-l005", "runs": [{"typeface": "roman", "text": "Gudon. Vorocani nibuxi."}, {"typeface": "italic", "text": " Rudeza, ou ig-"}]},
        {"id": "c2g-l006", "indent": 1, "runs": [{"typeface": "italic", "text": "norancia."}]},
        {"id": "c2g-l007", "runs": [{"typeface": "roman", "text": "Gudonna."}, {"typeface": "italic", "text": " Rude, & ignorante."}]},
        {"id": "c2g-l008", "indent": 1, "runs": [{"typeface": "roman", "text": "Gudonni."}]},
        {"id": "c2g-l009", "indent": 1, "runs": [{"typeface": "roman", "text": "Gudonſa."}]}
