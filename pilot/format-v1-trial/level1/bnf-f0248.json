        {"id": "c1p-l002", "indent": 1, "runs": [{"typeface": "italic", "text": "gũ ſenhor principal."}, {"typeface": "italic", "text": " (", "placement": "far-right"}, {"typeface": "italic", "text": "grande.", "placement": "far-right"}]},
        {"id": "c1p-l003", "runs": [{"typeface": "roman", "text": "Gozadocoro."}, {"typeface": "italic", "text": " Lugar onde eſtá algum ſenhor"}]}
